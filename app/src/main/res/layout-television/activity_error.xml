<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tv_safe_horizontal"
    android:paddingVertical="@dimen/tv_safe_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_error_title"
        android:textColor="@color/textColor"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_grid_half_gutter"
        android:text="@string/tv_error_recovery"
        android:textColor="@color/textColor_87"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_grid_gutter"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvErrorHome"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/tv_error_home"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvErrorDetails"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tv_grid_gutter"
            android:minHeight="52dp"
            android:text="@string/tv_error_details"
            android:textSize="17sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tvErrorTrace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tv_grid_gutter"
        android:layout_weight="1"
        android:background="@drawable/tv_navigation_panel"
        android:padding="@dimen/tv_grid_gutter"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/errorMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColor"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stackTraceTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_grid_half_gutter"
                android:fontFamily="monospace"
                android:textColor="@color/textColor_87"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
