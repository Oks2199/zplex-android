<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:paddingStart="@dimen/tv_safe_horizontal"
    android:paddingTop="@dimen/tv_safe_vertical"
    android:paddingEnd="@dimen/tv_safe_horizontal"
    android:paddingBottom="@dimen/tv_safe_vertical">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/bottomNavigationView"
        android:layout_width="112dp"
        android:layout_height="0dp"
        android:background="@drawable/tv_navigation_panel"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemBackground="@drawable/tv_navigation_item"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/tv_navigation_content"
        app:itemMinHeight="64dp"
        app:itemPaddingTop="10dp"
        app:itemPaddingBottom="10dp"
        app:itemRippleColor="@null"
        app:itemTextAppearanceActive="@style/TextAppearance.Movynex.Tv.Navigation"
        app:itemTextAppearanceInactive="@style/TextAppearance.Movynex.Tv.Navigation"
        app:itemTextColor="@color/tv_navigation_content"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/bottom_navigation_menu"
        app:menuGravity="center"
        tools:viewBindingType="com.google.android.material.navigation.NavigationBarView" />

    <FrameLayout
        android:id="@+id/zplex_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/tv_grid_gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bottomNavigationView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mainNavHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/zplex_graph" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
