<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/tv_accent</item>
        <item name="colorOnPrimary">@color/tv_accent_ink</item>
        <item name="colorSurface">@color/tv_background</item>
        <item name="colorSurfaceContainer">@color/tv_surface</item>
        <item name="colorSecondaryContainer">@color/tv_panel</item>
        <item name="colorOnSecondaryContainer">@color/tv_accent</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="actionBarSize">64dp</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="popupMenuBackground">@drawable/popup_menu_bg</item>
        <item name="android:listPopupWindowStyle">@style/MyListPopupWindow</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
    </style>

    <style name="seasonTitleTextAppearance" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/textColor</item>
        <item name="fontFamily">@font/open_sans_semibold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="seasonSubtitleTextAppearance" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/textColor_87</item>
        <item name="fontFamily">@font/open_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="tabTitleTextAppearance">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Movynex.Tv.Navigation" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
